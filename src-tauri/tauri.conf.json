{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cellar Door",
  "version": "0.1.0",
  "identifier": "dev.edkubiak.cellar-door-desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cellar Door",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "plugins": {
    "shell": {
      "scope": [
        { "name": "ollama-serve", "cmd": "ollama", "args": ["serve"] },
        { "name": "ollama-list",  "cmd": "ollama", "args": ["list"] }
      ]
    },
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/ek33450505/cellar-door-desktop/releases/latest/download/latest.json"
      ],
      "active": false,
      "dialog": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
