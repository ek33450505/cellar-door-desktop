{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        { "name": "ollama-serve", "cmd": "ollama", "args": ["serve"] },
        { "name": "ollama-list",  "cmd": "ollama", "args": ["list"] }
      ]
    },
    "shell:allow-kill",
    "dialog:default"
  ]
}
